PORT=3001
NODE_ENV=development

# MongoDB Atlas o MongoDB local
MONGO_DB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.5kimh5i.mongodb.net/<db_name>?appName=Cluster0
MONGO_DB_USER=your_mongodb_username
MONGO_DB_PASSWORD=your_mongodb_password
MONGO_DB_NAME=ecomerceDB

# Clave privada para firmar JWT. Cambiala por otra en produccion.
JWT_SECRET=your_jwt_secret_key

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Mercado Pago
MP_ACCESS_TOKEN=your_mercadopago_access_token
MERCADOPAGO_WEBHOOK_SECRET=your_mercadopago_webhook_secret

# Almacenamiento de imágenes de productos: "local" (carpeta /uploads) o "postimg"
STORAGE_PROVIDER=local
# Solo para STORAGE_PROVIDER=postimg. Se obtiene logueado en https://postimages.org/login/api
POSTIMG_API_KEY=your_postimages_api_key
